# Official company profiles. Leave empty until confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Dashboard (copy to .env.local). Read only by the Next.js server; never prefix these with NEXT_PUBLIC_.
# Where the Next.js server finds the Plumo API (FastAPI).
PLUMO_API_URL=http://127.0.0.1:8000
# The same value as PLUMO_API_KEY in backend/.env. Empty only when the API runs without a key (local development).
PLUMO_API_KEY=
