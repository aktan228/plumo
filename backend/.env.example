# PostgreSQL. Local: scripts/local-db.ps1 start (or docker compose up -d db).
# Supabase: paste the "Transaction pooler" string as is (postgresql://...:6543/postgres).
DATABASE_URL=postgresql+asyncpg://plumo:plumo@localhost:5432/plumo

# mock | production
# production selects the providers named below.
# Those providers must be registered in the factories. Nothing is registered
# except "mock" until you add a real adapter. See INTEGRATION.md.
AI_MODE=mock

# Small model: none until the local one exists. In production "none" and "mock"
# both send the small model's turns to the big one; mock never answers customers.
SMALL_MODEL_PROVIDER=mock
BIG_MODEL_PROVIDER=mock
# mock | elevenlabs. Chat voice messages are never transcribed by the mock (docs/voice-messages.md).
STT_PROVIDER=mock
TTS_PROVIDER=mock
LANGUAGE_DETECTOR=mock
# mock | telegram. Telegram works in AI_MODE=mock too.
# This bot only notifies managers. The customers' Telegram bot is a separate
# channel connection (CHANNEL_CREDENTIALS_FILE); do not reuse one token for both.
# Recommended setup (docs/manager-notifications.md): token and @name of the service bot, then
# `python -m app.manager_bot` points its webhook at /api/v1/webhooks/telegram-manager,
# signed from CHANNEL_SECRET_KEY.
HANDOFF_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Legacy shared chat id is ignored by the runtime; each business confirms its own manager.
# TELEGRAM_MANAGER_CHAT_ID=
# Compatibility with the older Dashboard setup only. Leave empty on a new stand: if set,
# MANAGER_BOT_TOKEN / MANAGER_BOT_USERNAME win over TELEGRAM_BOT_*. MANAGER_WEBHOOK_SECRET is
# needed only for the older /webhooks/manager-telegram endpoint (python -m app.setup_manager_bot).
# MANAGER_BOT_TOKEN=
# MANAGER_BOT_USERNAME=
# MANAGER_WEBHOOK_SECRET=
# Optional: "Открыть диалог" link in the card -> <DASHBOARD_URL>/dashboard?conversation=<id>#chats
DASHBOARD_URL=
ROUTER=rules

# Live text model. Pick one family for SMALL/BIG_MODEL_PROVIDER, see docs/MODELS.md.
#   gemini_small / gemini_big           Google AI Studio directly (recommended)
#   openrouter_small / openrouter_big   OpenRouter, any model, +5.5% on top-ups
#   openai_compat_small / _big          DeepSeek, OpenAI, Groq, LiteLLM...
#   local_small / local_big             own server: vLLM, Ollama, llama.cpp (fine-tuned small model)
# Target setup: SMALL_MODEL_PROVIDER=local_small, BIG_MODEL_PROVIDER=gemini_big.
# Now (no small model yet):
# AI_MODE=production
# SMALL_MODEL_PROVIDER=none
# BIG_MODEL_PROVIDER=gemini_big
#
# gemini-2.5-flash and -lite are retired on 2026-10-20: do not use them.
# Fallback models take over when the first one answers 404 / "no longer available".
# Prices (USD per 1M in/out, 2026-10-09): 3.8/3.7/3.6-flash 0.75/3.75 (double from
# 2027-01-01), 3.1-flash-lite 0.25/1.50. Check: python -m app.ping_llm

GEMINI_API_KEY=
GEMINI_SMALL_MODEL=gemini-3.1-flash-lite
GEMINI_BIG_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_SMALL_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BIG_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4.5

# Claude through the Anthropic SDK: anthropic_small / anthropic_big.
# Also used by the model benchmark (python -m app.bench).
ANTHROPIC_API_KEY=
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
ANTHROPIC_BIG_MODEL=claude-sonnet-5-5
# low = short sales replies; thinking is switched off per model in the adapter.
ANTHROPIC_EFFORT=low

# Thinking tokens are billed as output and delay speech. Empty = automatic:
# "minimal" on Gemini 3 (it cannot be off there; "none" gives HTTP 400), "none" on 2.5.
LLM_REASONING_EFFORT=
# Retries with backoff on 429/5xx/network, inside the turn budget.
LLM_MAX_RETRIES=2

# Self-hosted OpenAI-compatible server. Key optional, cost counted as 0.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_SMALL_MODEL=plumo-small
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_S=20

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/chat/completions
LLM_SMALL_MODEL=deepseek-chat
LLM_BIG_MODEL=deepseek-chat

DEFAULT_LANGUAGE=ru
# Optional. When empty, the only business in the database is used.
DEFAULT_BUSINESS_ID=

# development | stand | production. Not development: the API refuses to start
# without PLUMO_API_KEY and CHANNEL_SECRET_KEY, and the mock channel endpoint is off.
APP_ENV=development
# Service key for /api/v1: header X-API-Key. The dashboard's Next.js server sends
# it (frontend/.env.local PLUMO_API_KEY, the same value); the browser never sees it.
# Empty = open API, only for local development.
PLUMO_API_KEY=
# Browser origins allowed to call this API directly. The dashboard goes through
# Next.js, so a stand needs none. Empty = CORS off.
CORS_ORIGINS=
# Dashboard operator session, hours.
SESSION_TTL_HOURS=12

# --- Telegram and Instagram channels (docs/CHANNELS.md) ---
# Public https:// address of THIS API for webhooks (cloudflared/ngrok/domain), no trailing slash.
PUBLIC_BASE_URL=
# Long random string. Telegram webhook secrets are derived from it; changing it
# invalidates connected webhooks (reconnect them).
CHANNEL_SECRET_KEY=
# JSON file with server-side channel tokens, see channel-credentials.example.json.
# It is git-ignored; the dashboard only picks a credential by name.
CHANNEL_CREDENTIALS_FILE=channel-credentials.json
# Tokens referenced from that file by "token_env" (names are yours to choose).
TELEGRAM_DEMO_BOT_TOKEN=
INSTAGRAM_DEMO_ACCESS_TOKEN=
# Instagram API with Instagram Login: app secret (signs webhooks) and the verify
# token you type in the Meta App Dashboard webhook settings.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v25.0
# Seconds for one call to Telegram/Meta when sending.
CHANNEL_SEND_TIMEOUT_S=15
# Days a raw webhook copy keeps the customer's text and name; the dialog history stays. 0 = forever.
INBOUND_RETENTION_DAYS=30
# Worker: parallel jobs and idle polling interval.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_S=0.5

LOG_LEVEL=INFO
SMALL_MODEL_CONFIDENCE_THRESHOLD=0.7
# Seconds the model may take per turn. After that the agent says a prepared
# line instead of keeping a caller in silence.
VOICE_TURN_BUDGET_S=5
# Seconds before a slow voice turn sends a second identical request. 0 = off.
VOICE_HEDGE_AFTER_S=3
CHAT_TURN_BUDGET_S=25
# Hours an accepted, unresolved handoff keeps the agent silent in that dialog.
# 0 = until a manager returns the dialog to the agent (recommended for the stand). A phone call always gets a "manager will call
# back" line instead of silence, and every call is its own dialog.
MANAGER_PAUSE_HOURS=24
# A voice turn with lower speech-recognition confidence goes to the big model
# (only when the voice layer reports stt_confidence in metadata).
STT_LOW_CONFIDENCE=0.6

# Phone calls: ElevenLabs Agents owns SIP, STT, TTS and barge-in,
# Plumo answers as its Custom LLM. See VOICE.md.
VOICE_PLATFORM=elevenlabs
# Bearer token ElevenLabs sends to /telephony/elevenlabs/* (Custom LLM API key).
ELEVENLABS_LLM_TOKEN=
# HMAC secret of the post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Platform price per call minute from your ElevenLabs plan, for cost metrics.
VOICE_USD_PER_MINUTE=0
# `python -m app.elevenlabs_setup`, and the worker when STT_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
# Public https address of this backend that ElevenLabs calls (ngrok etc.).
PLUMO_PUBLIC_URL=
# Optional agent voice and TTS model; empty = ElevenLabs defaults.
# Kyrgyz needs eleven_v3_conversational or eleven_v4_turbo; eleven_flash_v2_5 has no
# Kyrgyz (GET /v1/models, 2026-10-09). Compare: python -m app.voice_probe
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
# Filled by the setup script so a rerun updates instead of creating new ones.
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET_ID=
ELEVENLABS_POST_CALL_WEBHOOK_ID=

# Account verification and password reset (Resend). AUTH_PUBLIC_URL is the FRONTEND origin.
AUTH_PUBLIC_URL=
# Temporary stand without an email domain: false permits password login without email verification.
# Does not mark addresses verified. Password reset still requires Resend.
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Authenticated agent tests: shared allowance per business, UTC day.
TEST_CHAT_DAILY_MESSAGES=50
TEST_CHAT_SESSION_MESSAGES=20
TEST_CHAT_DAILY_BUDGET_USD=1.0
TEST_CHAT_TURN_RESERVE_USD=0.05

# Worker inside the API process. Stands use a separate `python -m app.worker` instead
# (docs/operations.md), so keep it false there. The Docker image alone defaults to true;
# docker-compose sets false because it runs the `worker` service.
# CHANNEL_WORKER_ENABLED=false
# The image runs `alembic upgrade head` on start. On a stand migrations are a release step: false.
# MIGRATE_ON_START=false
# Commit shown in /ops/status. Not needed when the hosting sets RENDER_GIT_COMMIT or SOURCE_COMMIT.
# APP_COMMIT=

# Channel traffic limits (docs/limits.md). UTC day.
LIMIT_SENDER_MESSAGES=10
LIMIT_SENDER_WINDOW_S=300
LIMIT_BUSINESS_DAILY_CALLS=300
LIMIT_BUSINESS_DAILY_USD=3
LIMIT_SERVICE_DAILY_USD=20
LIMIT_QUEUE_PER_BUSINESS=200
LIMIT_RATE_WINDOW_S=60
LIMIT_BUSINESS_WINDOW_TURNS=20
LIMIT_SERVICE_WINDOW_TURNS=60
TURN_RESERVE_USD=0.01
COST_VERSION=2026-10

# Telegram voice messages (docs/voice-messages.md). Transcribed only with AI_MODE=production
# and a real STT_PROVIDER (elevenlabs, key ELEVENLABS_API_KEY); otherwise the "text only" line.
VOICE_MESSAGES_ENABLED=false
# Defaults below; uncomment to change.
# VOICE_MAX_DURATION_S=120
# Mean word confidence under which a transcript counts as unclear. 0 = off (not calibrated yet).
# STT_MIN_CONFIDENCE=0
# Price estimate per audio minute for limits; Scribe v2 $0.22/hour (2026-11-06).
# STT_USD_PER_MINUTE=0.0037
# STT_COST_VERSION=elevenlabs-scribe_v2-2026-11-06
# STT_TIMEOUT_S=30
# ELEVENLABS_STT_MODEL=scribe_v2
# true sends enable_logging=false: zero retention, ElevenLabs enterprise plans only.
# ELEVENLABS_STT_ZERO_RETENTION=false

# Monitoring summary GET /ops/status (docs/monitoring.md). Empty: the summary is off.
OPS_TOKEN=

# Website pilot requests go to this team chat through the service bot (TELEGRAM_BOT_TOKEN). Empty: stored only.
TEAM_TELEGRAM_CHAT_ID=
